# Copy to .env and fill in. .env is gitignored.
GLM_BASE_URL=https://your-model-endpoint.example.com/v1
GLM_MODEL=glm-53-fp8-v10
# a token, or the word oc to use `oc whoami -t` from your current oc login (log into the model's cluster first)
GLM_API_KEY=oc
GLM_TIMEOUT=120
# set to 0 if the endpoint has a self-signed cert you trust
GLM_VERIFY_TLS=1
# 0 strips the tagged reasoning block but GLM-5.3 then reasons inside the visible answer
# (about half the tokens, messier output). Leave at 1 unless you are measuring that trade-off.
GLM_THINKING=1
