# Settings for the standalone runner, server and eval, and the optional vision / OCR models that the plugin can
# also use. Copy to .env (standalone checkout) or to ~/.config/context-graph/.env (plugin users; the plugin
# folder itself is replaced on update). Environment variables override the file. .env is gitignored.
# The Claude Code plugin needs none of the MODEL_BASE_URL/MODEL_NAME lines: Claude Code supplies the chat model.
#
# Any OpenAI-compatible chat endpoint works. Examples:
#   vLLM / OpenShift AI route:  MODEL_BASE_URL=https://<route>/v1        MODEL_API_KEY=cmd:oc whoami -t
#   Ollama:                     MODEL_BASE_URL=http://localhost:11434/v1  MODEL_API_KEY=none  MODEL_NAME=qwen2.5-coder:14b
#   LiteLLM proxy:              MODEL_BASE_URL=https://litellm.example.com/v1  MODEL_API_KEY=sk-...
#   OpenAI / OpenRouter / Zhipu: their documented base URL and key
MODEL_BASE_URL=https://your-model-endpoint.example.com/v1
MODEL_API_KEY=
MODEL_NAME=your-model-id
# cheaper model for classification and the eval judge (defaults to MODEL_NAME)
MODEL_FAST=
# provider-specific request fields, JSON. Reasoning models: vLLM {"chat_template_kwargs":{"enable_thinking":false}},
# OpenAI-style {"reasoning_effort":"low"}, Ollama {"think":false}. Leave empty for defaults.
MODEL_EXTRA_BODY=
MODEL_TIMEOUT=120
# 0 if the endpoint has a self-signed certificate you trust
MODEL_VERIFY_TLS=1
# Claude Code's ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_MODEL are read as fallbacks when they point
# at a proxy such as LiteLLM that also serves /v1/chat/completions.

# Optional: a vision-capable model to describe figures and charts in documents (plugin and standalone tools).
# Unset = figures get OCR text and nothing is invented about them. Any OpenAI-compatible endpoint that accepts
# image input: e.g. qwen3-vl on vLLM or LiteLLM, gpt-4o, gemini via a proxy. Captions are cached per figure and
# marked "(model description, inferred)" in the text.
MODEL_VISION_NAME=
MODEL_VISION_BASE_URL=
MODEL_VISION_API_KEY=
MODEL_VISION_MAX_FIGURES=40
# seconds one ingest/caption call may spend captioning before the rest is left pending (continue with /ctx caption)
MODEL_VISION_BUDGET_S=150

# Optional: a model that reads text out of images and scanned pages instead of the built-in RapidOCR (default).
# A document model such as PaddleOCR-VL, or the same vision model as above. RapidOCR remains the fallback.
MODEL_OCR_NAME=
MODEL_OCR_BASE_URL=
MODEL_OCR_API_KEY=
